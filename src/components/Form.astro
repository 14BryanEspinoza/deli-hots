---
import { data } from "@lib/api";
import Input from "@components/Input.astro";

const product = data.map((item) => ({
  name: item.name,
  price: item.price,
}));

const thankYouUrl = Astro.site
  ? new URL(import.meta.env.BASE_URL + "gracias/", Astro.site).href
  : import.meta.env.BASE_URL + "gracias/";
---

<form
  action="https://formsubmit.co/14bryespinoza@gmail.com"
  class="mx-8 my-24 lg:mx-auto lg:max-w-4xl"
  method="post"
>
  <input type="hidden" name="_next" value={thankYouUrl} />
  <input type="hidden" name="_subject" value="Nuevo pedido - Deli's Hots" />

  <h1 class="text-center text-2xl font-bold">Haz tu pedido</h1>

  <p class="my-4 text-center text-text-muted">
    Entrega a domicilio · Sin compra mínima · Paga al recibir
  </p>

  <fieldset class="my-6 rounded-md border border-border bg-surface p-4 shadow">
    <legend class="font-semibold text-text">Información personal</legend>

    <Input
      id="name"
      label="Nombre completo"
      type="text"
      place="Juan Pérez"
      autocomplete="name"
    />

    <Input
      id="tel"
      label="Teléfono"
      type="tel"
      place="+505 1234-5678"
      autocomplete="tel"
      pattern="[+]?[0-9\s\(\)\-]{7,}"
    />

    <Input
      id="address"
      label="Dirección de entrega"
      type="text"
      place="Covisama II Etapa, Casa I-2-10"
      autocomplete="street-address"
    />
  </fieldset>

  <fieldset class="my-6 rounded-md border border-border bg-surface p-4 shadow">
    <legend class="font-semibold text-text">Detalles del pedido</legend>

    <div class="mx-4 mb-4">
      <label class="mb-2 ml-4 block" for="product">
        Producto
      </label>

      <select
        class="w-full rounded-md border border-border px-6 py-2 shadow-md transition placeholder:text-text-muted invalid:border-danger focus:border-accent"
        id="product"
        name="product"
        required
      >
        <option value="" disabled selected>
          Selecciona un producto
        </option>

        {product.map((item) => (
          <option value={item.name}>
            {item.name} - C${item.price}
          </option>
        ))}
      </select>
    </div>

    <Input
      id="amount"
      label="Cantidad"
      type="number"
      place="1"
      autocomplete="amount"
      min={1}
    />

    <div class="mx-4 mb-4">
      <label class="mb-2 ml-2 block" for="comments">
        Comentarios
      </label>

      <textarea
        class="w-full rounded-md border border-border px-6 py-2 shadow-md transition placeholder:text-text-muted invalid:border-danger focus:border-accent"
        id="comments"
        name="comments"
        placeholder="Describe tus preferencias del producto."
        rows="3"
      ></textarea>
    </div>
  </fieldset>

  <button
    class="w-full cursor-pointer rounded-md bg-accent p-4 font-bold text-bg transition hover:bg-accent-hover hover:text-bg hover:scale-105"
    type="submit"
  >
    Realizar pedido
  </button>
</form>
