---
import { Icon } from "astro-icon/components";
import { linkNavbar } from "@data/links";
import Link from "@components/Link.astro";

const currentPath = Astro.url.pathname;
---

<figure class="size-10">
  <a href={import.meta.env.BASE_URL}>
    <img
      src={import.meta.env.BASE_URL + "favicon.png"}
      alt="Ir al inicio"
      loading="eager"
      class="object-contain"
    />
  </a>
</figure>

<button
  type="button"
  id="menu-toggle"
  class="md:hidden"
  aria-expanded="false"
  aria-controls="nav-main"
  aria-label="menú de navegación"
>
  <Icon name="lucide:menu" class="cursor-pointer text-3xl" aria-hidden="true" />
</button>

<nav
  id="nav-main"
  class="hidden h-[90dvh] w-full flex-col items-center justify-center md:flex md:h-auto md:w-auto"
  aria-label="navegación principal"
>
  <ul role="list" class="md:flex md:items-center md:gap-8">
    {linkNavbar.map((link) => {
      const normalize = (path: string) => path.replace(/\/$/, "");
      const isActive = normalize(currentPath) === normalize(link.url);

      return (
        <li>
          <Link {...link} className="mt-12 md:mt-0" active={isActive} />
        </li>
      );
    })}
  </ul>
</nav>

<script>
  const btn = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-main");

  let open = false;

  const setOpen = (next: boolean) => {
    open = next;

    btn?.setAttribute("aria-expanded", String(open));

    nav?.classList.toggle("hidden", !open);
    nav?.classList.toggle("flex", open);
  };

  btn?.addEventListener("click", () => setOpen(!open));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && open) {
      setOpen(false);
      btn?.focus();
    }
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });
</script>
