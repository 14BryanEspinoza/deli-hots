---
import { Icon } from "astro-icon/components";
import Link from "@components/Link.astro";
import { linkNavbar } from "@data/links";

const currentPath = Astro.url.pathname;
---

<figure class="size-12">
  <a href={import.meta.env.BASE_URL}>
    <img
      src={import.meta.env.BASE_URL + "favicon.png"}
      alt="Ir al inicio"
      loading="eager"
      class="object-contain"
    />
  </a>
</figure>

<input type="checkbox" id="menu-toggle" class="peer hidden" />
<label for="menu-toggle" aria-label="abrir menú">
  <Icon name="lucide:menu" class="cursor-pointer text-3xl md:hidden" />
</label>

<nav
  class="hidden h-[90dvh] w-full flex-col items-center justify-center peer-checked:flex md:flex md:h-auto md:w-auto"
  aria-label="navegación principal"
>
  <ul role="list" class="md:flex md:items-center md:gap-8">
    {linkNavbar.map((link) => {
      const normalize = (path: string) => path.replace(/\/$/, "");
      const isActive = normalize(currentPath) === normalize(link.url);

      return (
        <li>
          <Link {...link} className="mt-12 md:mt-0" active={isActive} />
        </li>
      );
    })}
  </ul>
</nav>
