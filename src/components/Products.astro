---
import { Picture } from "astro:assets";
import Link from "@components/Link.astro";
import type { DataProps } from "@lib/api";

const { name, price, category, image } = Astro.props as DataProps;
---

<article class="flex flex-col overflow-hidden rounded-md border border-border bg-surface shadow transition hover:scale-105 hover:shadow-md">
  <figure>
    <Picture
      src={image}
      alt={name}
      inferSize
      formats={["avif", "webp"]}
      loading="lazy"
      decoding="async"
      class={"object-cover"}
    />
  </figure>

  <div class="flex flex-1 flex-col justify-between gap-4 p-4">
    <div class="flex flex-col gap-2">
      <h3 class="text font-bold text-balance">{name}</h3>
      <span class="text-text-muted uppercase underline">{category}</span>
    </div>

    <div class="flex items-center justify-end gap-2">
      <p class="italic">C$ {price}</p>
      <span class="text-sm uppercase"> / 1 UND</span>
    </div>

    <Link
      url="/orders"
      label="Pedir"
      className="bottom mt-4 rounded-md bg-accent py-2 font-bold text-bg transition hover:bg-accent-soft hover:text-text"
    />
  </div>
</article>
