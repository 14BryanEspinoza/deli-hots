---
import { Picture } from "astro:assets";
import type { DataProps } from "@lib/api";
import Link from "@components/Link.astro";

const { name, price, category, image } = Astro.props as DataProps;
---

<article class="flex flex-col overflow-hidden rounded-md border border-border bg-surface-alt transition hover:scale-105 hover:shadow">
  <figure>
    <Picture
      src={image}
      alt={name}
      inferSize
      formats={["avif", "webp"]}
      loading="lazy"
      decoding="async"
      class={"object-cover"}
    />
  </figure>

  <div class="flex flex-1 flex-col justify-between gap-4 p-4">
    <div class="flex">
      <h3 class="font-bold text-balance text-text">{name}</h3>

      <span class="text-text-muted uppercase">{category}</span>
    </div>

    <div class="flex items-center justify-end gap-2">
      <p class="italic">C${price}</p>

      <span class="text-sm uppercase">/ 1 UND</span>
    </div>

    <Link
      url={import.meta.env.BASE_URL + "orders/"}
      label="Pedir"
      className="mt-4 rounded-md bg-accent py-2 font-bold text-bg transition hover:bg-accent-hover hover:text-bg"
    />
  </div>
</article>
