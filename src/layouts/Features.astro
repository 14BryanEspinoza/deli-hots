---
import { features } from "@data/features";
import Cards from "@components/Cards.astro";
---

<section class="bg-surface-alt px-8 py-24">
  <h2 class="text-center text-xl font-bold">¿Por qué elegir Deli's Hots?</h2>

  <p class="my-4 text-center text-text-muted md:max-w-xl md:mx-auto">
    Nos tomamos tu comida en serio: frescura, rapidez y buenos precios con cada
    pedido.
  </p>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
    {features.map((item) => (
      <Cards {...item} />
    ))}
  </div>
</section>
