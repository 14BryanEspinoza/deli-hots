---
import Link from "@components/Link.astro";
import { linkNavbar, socialNetworks, linkOthers } from "@data/links";
---

<footer id="contact" class="bg-footer-bg px-8 py-16 text-footer-muted">
  <h2 class="mb-4 text-2xl font-bold text-footer-text uppercase">
    Deli's Hots
  </h2>
  <p>Fast, fresh food with a taste of home.</p>

  <section class="my-12 grid grid-cols-1 gap-12 md:grid-cols-2">
    <article>
      <h3 class="mb-4 font-bold text-footer-text">Social Networks</h3>

      <nav aria-label="social links">
        <ul class="flex gap-8">
          {socialNetworks.map((link) => (
            <li>
              <Link
                {...link}
                className="rounded-full border border-text-muted p-3 hover:border-footer-text hover:text-footer-text"
              />
            </li>
          ))}
        </ul>
      </nav>
    </article>

    <article>
      <h3 class="mb-4 font-bold text-footer-text">Navigation</h3>

      <nav aria-label="footer links">
        <ul class="flex flex-col items-start gap-8 lg:flex-row">
          {linkNavbar.map((link) => (
            <li>
              <Link
                {...link}
                className="hover:border-footer-text hover:text-footer-text hover:underline"
              />
            </li>
          ))}
        </ul>
      </nav>
    </article>

    <article>
      <h3 class="mb-4 font-bold text-footer-text">Contact</h3>

      <address class="mb-8">
        Av. Los Robles #123 <br /> Managua, Nicaragua
      </address>
      <ul class="flex flex-col gap-8">
        <li>
          <a href="tel:+50588880000">Tel: +505 8888 0000</a>
        </li>
        <li>
          <a href="mailto:pedidos@delishots.com">Mail: pedidos@delishots.com</a>
        </li>
      </ul>
    </article>

    <article>
      <h3 class="mb-4 font-bold text-footer-text">Horario</h3>

      <ul class="flex flex-col gap-8">
        <li>Lun – Vie · 10:00 am – 20:00 pm</li>
        <li>Sáb – Dom · 8:00 am – 22:00 pm</li>
      </ul>
    </article>
  </section>

  <article class="flex flex-col items-center gap-8 border-t border-border pt-12 md:flex-row md:justify-between">
    <nav aria-label="legal links">
      <ul class="flex gap-12" role="list">
        {linkOthers.map((link) => (
          <li>
            <Link
              url={link.url}
              label={link.label}
              className="hover:border-footer-text hover:text-footer-text hover:underline"
            />
          </li>
        ))}
      </ul>
    </nav>

    <small class="opacity-90">&copy; 14BryanEspinoza - 2026</small>
  </article>
</footer>
