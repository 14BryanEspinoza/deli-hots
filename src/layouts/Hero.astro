---
import { ImageCarousel } from "@components/Carousel";
import Link from "@components/Link.astro";
import { data } from "@lib/api";
import { getCarouselImages } from "@lib/images";
import { pickCarousel } from "@lib/selection";

const carouselImages = await getCarouselImages(
  pickCarousel(data).map((item) => ({
    url: item.image,
    alt: item.name,
  })),
);
---

<section class="px-8 py-24 text-center text-text">
  <h1 class="mb-4 text-4xl font-bold">Deli's Hots</h1>

  <p class="mx-auto mb-6 max-w-2xl text-lg">
    Comida rápida preparada con ingredientes frescos y llena de sabor.
    Hamburguesas, pizzas, hot dogs, tacos y más—listos en minutos y entregados
    calientes a tu puerta.
  </p>

  <div class="flex flex-wrap justify-center gap-8">
    <Link
      url={import.meta.env.BASE_URL + "menu/"}
      label="Ver menú"
      icon="lucide:arrow-right"
      className="rounded-md bg-accent p-4 font-bold text-bg hover:bg-accent-soft hover:text-text"
    />
    <Link
      url={import.meta.env.BASE_URL + "orders/"}
      label="¡Haz tu pedido ahora!"
      icon="lucide:arrow-right"
      className="rounded-md border border-border p-4 font-bold hover:bg-accent-soft hover:text-text"
    />
  </div>

  {carouselImages.length > 0 && (
    <div class="mt-12">
      <ImageCarousel images={carouselImages} client:load />
    </div>
  )}
</section>
