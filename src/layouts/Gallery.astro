---
interface Props {
  products?: DataProps[];
}

import Products from "@components/Products.astro";
import { data } from "@lib/api";
import type { DataProps } from "@lib/api";

const { products = data } = Astro.props as Props;
---

<section class="px-8 py-24 text-text">
  <h1 class="mb-4 text-center text-4xl font-bold">Menú</h1>
  <p class="mx-auto mb-6 max-w-2xl text-center text-lg">
    Desde el clásico hot dog hasta los fish and chips, cada plato se prepara al
    pedido. Encuentra tu favorito.
  </p>
  <div class="mx-auto grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4 lg:px-16">
    {products.length > 0 ? (
      products.map((product) => <Products {...product} />)
    ) : (
      <p class="col-span-full py-6 text-center text-lg text-text">
        No se encontraron productos
      </p>
    )}
  </div>
</section>
