---
interface Props {
  products?: DataProps[];
}

import { data } from "@lib/api";
import type { DataProps } from "@lib/api";
import Products from "@components/Products.astro";

const { products = data } = Astro.props;
---

<section class="px-8 py-24">
  <h2 class="mb-4 text-center text-2xl font-bold text-text">Menú</h2>

  <p class="mb-6 text-center text-text-muted md:max-w-xl md:mx-auto">
    Desde el clásico hot dog hasta los fish and chips, cada plato se prepara al
    pedido. Encuentra tu favorito.
  </p>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 md:px-12">
    {products.length > 0 ? (
      products.map((product) => <Products {...product} />)
    ) : (
      <p class="col-span-full py-6 text-center text-xl text-text-muted">
        No se encontraron productos
      </p>
    )}
  </div>
</section>
